---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<nav class="nav">
  <a class="nav__mark" href={base}>
    <img src={`${base}mark.png`} width="26" height="26" alt="gothalo" />
    <span>gothalo</span>
  </a>
  <div class="nav__links">
    <a class="nav__app" href={`${base}app/`}>Web app</a>
    <a href={`${base}docs/`}>Docs</a>
    <a href="https://github.com/dipeshdulal/gothalo">GitHub</a>
    <a class="nav__cta" href="#install">Install</a>
  </div>
</nav>
