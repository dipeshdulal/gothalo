<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>gothalo — web push receiver</title>
  <style>
    body { font: 15px/1.5 -apple-system, system-ui, sans-serif; max-width: 720px;
           margin: 40px auto; padding: 0 16px; color: #222; }
    h1 { font-size: 18px; }
    button { font: inherit; padding: 8px 14px; border: 1px solid #888; border-radius: 8px;
             background: #f6f6f6; cursor: pointer; }
    #token { width: 100%; height: 90px; margin-top: 8px; font-family: ui-monospace, monospace;
             font-size: 12px; }
    #log { margin-top: 16px; padding: 10px; background: #111; color: #0f0;
           font-family: ui-monospace, monospace; font-size: 12px; border-radius: 8px;
           white-space: pre-wrap; min-height: 80px; }
    .msg { margin-top: 12px; padding: 12px; border: 2px solid #2a7; border-radius: 8px;
           background: #eaffea; }
  </style>
</head>
<body>
  <h1>gothalo — web push receiver (rung ⑤)</h1>
  <p>Grant notification permission, copy the token below, and hand it to the bridge.
     Keep this tab open (foreground or background) to receive pushes.</p>

  <button id="enable">Enable notifications &amp; register with bridge</button>
  <p><strong>Device token</strong> (auto-registered with the bridge; shown here for reference):</p>
  <textarea id="token" readonly placeholder="click the button above…"></textarea>
  <p><button id="reregister" disabled>Re-register this token with the bridge</button></p>

  <div id="latest"></div>
  <div id="log"></div>

  <!-- Firebase JS SDK (compat build — simplest for a single static page) -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-messaging-compat.js"></script>
  <script>
    // Placeholders: filled in by scripts/setup-firebase.sh from your own
    // Firebase project (see README "Push: bring your own Firebase").
    // __SETUP_FIREBASE__ (marker: the setup script replaces this whole block).
    const firebaseConfig = {
      apiKey: "YOUR_WEB_API_KEY",
      authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
      projectId: "YOUR_PROJECT_ID",
      storageBucket: "YOUR_PROJECT_ID.firebasestorage.app",
      messagingSenderId: "YOUR_SENDER_ID",
      appId: "YOUR_WEB_APP_ID"
    };
    const VAPID_KEY = "YOUR_VAPID_PUBLIC_KEY";

    const logEl = document.getElementById("log");
    const log = (m) => { logEl.textContent += m + "\n"; console.log(m); };

    // The page is served BY the bridge, so /register-token is same-origin.
    // The bridge token (?token=…) authenticates the register call; it defaults
    // to the value in this page's own URL query string.
    const bridgeToken = new URLSearchParams(location.search).get("token") || "";
    let lastToken = "";

    async function registerWithBridge(fcmTok) {
      const q = bridgeToken ? "?token=" + encodeURIComponent(bridgeToken) : "";
      try {
        const res = await fetch("/register-token" + q, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token: fcmTok }),
        });
        if (res.ok) log("✓ registered with bridge — this device will now receive pushes");
        else if (res.status === 401) log("✗ register failed: 401 — open this page as /?token=<bridge token>");
        else log("✗ register failed: HTTP " + res.status);
      } catch (e) {
        log("✗ register error: " + (e && e.message ? e.message : e));
      }
    }

    firebase.initializeApp(firebaseConfig);
    const messaging = firebase.messaging();

    // Foreground messages (tab focused) arrive here rather than as an OS notification.
    messaging.onMessage((payload) => {
      log("FOREGROUND message: " + JSON.stringify(payload));
      const d = payload.data || {};
      const n = payload.notification || {};
      const title = d.title || n.title || "(no title)";
      const body = d.body || n.body || "";
      document.getElementById("latest").innerHTML =
        '<div class="msg"><strong>' + title + "</strong><br>" + body + "</div>";
    });

    document.getElementById("enable").addEventListener("click", async () => {
      try {
        log("requesting notification permission…");
        const perm = await Notification.requestPermission();
        log("permission = " + perm);
        if (perm !== "granted") return;

        // The service worker handles background (tab unfocused) notifications.
        await navigator.serviceWorker.register("./firebase-messaging-sw.js");
        log("service worker registered — waiting for it to activate…");
        // getToken's PushManager.subscribe needs an ACTIVE worker; wait for it.
        const reg = await navigator.serviceWorker.ready;
        log("service worker active");

        const token = await messaging.getToken({ vapidKey: VAPID_KEY,
                                                 serviceWorkerRegistration: reg });
        lastToken = token;
        document.getElementById("token").value = token;
        document.getElementById("reregister").disabled = false;
        log("got token (" + token.length + " chars) — registering with bridge…");
        await registerWithBridge(token);
      } catch (e) {
        log("ERROR: " + (e && e.message ? e.message : e));
      }
    });

    document.getElementById("reregister").addEventListener("click", () => {
      if (lastToken) registerWithBridge(lastToken);
    });
  </script>
</body>
</html>
